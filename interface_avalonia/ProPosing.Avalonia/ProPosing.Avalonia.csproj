<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../sidecar/**/*" CopyToOutputDirectory="PreserveNewest">
      <Link>sidecar/%(Filename)%(Extension)</Link>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.1.3" />
    <PackageReference Include="Avalonia.Desktop" Version="11.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.1.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.1.3" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
    <PackageReference Include="OpenCvSharp4" Version="4.13.0.20260318" />
  </ItemGroup>

  <!-- Runtime nativo: usa NETCoreSdkRuntimeIdentifier para detectar a plataforma automaticamente
       mesmo quando -r não é passado para dotnet run/build. -->
  <ItemGroup Condition="$(NETCoreSdkRuntimeIdentifier.StartsWith('osx-arm64')) OR '$(RuntimeIdentifier)' == 'osx-arm64'">
    <PackageReference Include="OpenCvSharp4.runtime.osx_arm64" Version="4.8.1-rc" />
  </ItemGroup>

  <ItemGroup Condition="$(NETCoreSdkRuntimeIdentifier.StartsWith('osx-x64')) OR '$(RuntimeIdentifier)' == 'osx-x64'">
    <PackageReference Include="OpenCvSharp4.runtime.osx" Version="4.8.1-rc" />
  </ItemGroup>

  <ItemGroup Condition="$(NETCoreSdkRuntimeIdentifier.StartsWith('win')) OR '$(RuntimeIdentifier)' == 'win-x64'">
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.13.0.20260528" />
  </ItemGroup>

  <ItemGroup Condition="$(NETCoreSdkRuntimeIdentifier.StartsWith('linux')) OR '$(RuntimeIdentifier)' == 'linux-x64'">
    <PackageReference Include="OpenCvSharp4.official.runtime.linux-x64" Version="4.13.0.20260318" />
  </ItemGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets/Fonts/**" />
    <AvaloniaResource Include="Assets/References/**" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Assets/Logo/proposing.icns" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <None Include="pose_thresholds.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
