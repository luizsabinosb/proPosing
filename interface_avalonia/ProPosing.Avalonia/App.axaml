<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ProPosing.Avalonia.App">
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://ProPosing.Avalonia/Assets/Styles.axaml" />
  </Application.Styles>
  <Application.Resources>
  <FontFamily x:Key="MinhaFonte">avares://ProPosing.Avalonia/Assets/Fonts#Ethnocentric</FontFamily>
</Application.Resources>

</Application>
