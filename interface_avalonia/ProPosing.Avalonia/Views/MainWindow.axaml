<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:ProPosing.Avalonia.ViewModels"
        xmlns:converters="clr-namespace:ProPosing.Avalonia.Converters"
        xmlns:controls="clr-namespace:ProPosing.Avalonia.Views.Controls"
        x:Class="ProPosing.Avalonia.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="proPosing"
        Width="1600"
        Height="920"
        MinWidth="1280"
        MinHeight="720"
        Background="{StaticResource SurfaceBase}"
        KeyDown="OnWindowKeyDown"
        mc:Ignorable="d">

  <Window.Resources>
    <converters:StatusToLabelConverter x:Key="StatusToLabel" />
    <converters:StatusToBrushConverter x:Key="StatusToBrush" />
  </Window.Resources>

  <!-- Root: top bar + main content + footer -->
  <Grid RowDefinitions="56,*,32">

    <!-- ── Top branding bar ─────────────────────────────────────────── -->
    <Border Grid.Row="0"
            Background="{StaticResource SurfaceBase}"
            BorderBrush="{StaticResource AccentMuted}"
            BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="*,Auto" Margin="24,0">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="0">
          <TextBlock Text="pro"
                     FontFamily="{StaticResource DisplayFont}"
                     FontSize="22"
                     FontWeight="Bold"
                     FontStyle="Italic"
                     Foreground="White" />
          <TextBlock Text="Posing"
                     FontFamily="{StaticResource DisplayFont}"
                     FontSize="22"
                     FontWeight="Bold"
                     Foreground="{StaticResource Accent}" />
        </StackPanel>
        <TextBlock Grid.Column="1"
                   Text="Powered by Feral Tech Supplies"
                   FontSize="11"
                   FontStyle="Italic"
                   Foreground="{StaticResource TextMuted}"
                   VerticalAlignment="Center"
                   LetterSpacing="0.5" />
      </Grid>
    </Border>

    <!-- ── Main 3-column layout ─────────────────────────────────────── -->
    <Grid Grid.Row="1" ColumnDefinitions="260,*,440">

      <!-- LEFT — Poses panel -->
      <Border Grid.Column="0"
              Background="{StaticResource SurfacePanel}"
              BorderBrush="{StaticResource AccentMuted}"
              BorderThickness="0,0,1,0">
        <Grid RowDefinitions="Auto,*">

          <StackPanel Grid.Row="0" Spacing="4" Margin="20,20,20,16">
            <TextBlock Classes="panelTitle" Text="POSES" />
            <TextBlock Classes="caption"
                       Text="Teclas 0–9 para trocar"
                       FontWeight="Regular"
                       LetterSpacing="0" />
          </StackPanel>

          <ScrollViewer Grid.Row="1"
                        Padding="12,0,12,16"
                        VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Poses}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Spacing="8" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Classes="pose"
                          Classes.selected="{Binding IsSelected}"
                          Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).SelectPoseCommand}"
                          CommandParameter="{Binding Mode}">
                    <Grid ColumnDefinitions="36,*" VerticalAlignment="Center">
                      <Border Grid.Column="0" Classes="poseChip">
                        <TextBlock Text="{Binding Number}" />
                      </Border>
                      <TextBlock Grid.Column="1"
                                 Classes="poseLabel"
                                 Text="{Binding Label}" />
                    </Grid>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>

        </Grid>
      </Border>

      <!-- CENTER — Camera feed with traffic-light border + overlay feedback banner -->
      <Border Grid.Column="1"
              Background="Black"
              BorderBrush="{Binding Status, Converter={StaticResource StatusToBrush}, ConverterParameter=accent}"
              BorderThickness="2"
              ClipToBounds="True">
        <Grid>
          <!-- Uniform (letterbox) so the full frame is always visible — the user
               must see their whole body; UniformToFill would crop limbs out. -->
          <Image Source="{Binding CameraFrame}" Stretch="Uniform" />

          <controls:SkeletonOverlayControl Landmarks="{Binding Landmarks}"
                                           Status="{Binding Status}"
                                           ImageWidth="{Binding ImageWidth}"
                                           ImageHeight="{Binding ImageHeight}" />

          <!-- Placeholder when camera is off / waiting / error -->
          <Border IsVisible="{Binding ShowPlaceholder}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                        Spacing="20" MaxWidth="420">

              <!-- Waiting for permission -->
              <StackPanel IsVisible="{Binding HasCameraStatusMessage}"
                          Spacing="14" HorizontalAlignment="Center">
                <TextBlock Text="📷" FontSize="44" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding CameraStatusMessage}"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimary}"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           LineHeight="24" />
              </StackPanel>

              <!-- Idle -->
              <TextBlock IsVisible="{Binding !HasCameraStatusMessage}"
                         Text="Inicializando câmera..."
                         FontSize="15"
                         Foreground="{StaticResource TextMuted}"
                         HorizontalAlignment="Center" />

              <!-- Error -->
              <Border IsVisible="{Binding HasCameraError}"
                      Background="#14EF4444"
                      BorderBrush="{StaticResource AccentBorder}"
                      BorderThickness="1"
                      CornerRadius="12"
                      Padding="20,16">
                <StackPanel Spacing="12">
                  <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                    <TextBlock Text="⚠" FontSize="16" Foreground="{StaticResource Accent}" VerticalAlignment="Center" />
                    <TextBlock Text="Câmera indisponível"
                               FontSize="14"
                               FontWeight="Bold"
                               Foreground="{StaticResource Accent}"
                               VerticalAlignment="Center"
                               LetterSpacing="0.5" />
                  </StackPanel>
                  <TextBlock Text="{Binding CameraError}"
                             Foreground="{StaticResource TextSecondary}"
                             FontSize="13"
                             HorizontalAlignment="Center"
                             TextAlignment="Center"
                             TextWrapping="Wrap"
                             LineHeight="20" />
                  <Button Classes="loginBtn"
                          Content="Tentar novamente"
                          Command="{Binding StartCameraCommand}"
                          HorizontalAlignment="Center"
                          MinWidth="160"
                          Height="40"
                          Margin="0,4,0,0" />
                  <TextBlock Text="Reconexão automática a cada 15 segundos"
                             FontSize="12"
                             Foreground="{StaticResource TextMuted}"
                             HorizontalAlignment="Center" />
                </StackPanel>
              </Border>

            </StackPanel>
          </Border>

          <!-- Feedback banner overlaid at the bottom of the video -->
          <Border VerticalAlignment="Bottom"
                  Margin="16,0,16,16"
                  CornerRadius="10"
                  Padding="18,14"
                  Background="#EE0D0D0D"
                  BorderBrush="{Binding Status, Converter={StaticResource StatusToBrush}, ConverterParameter=border}"
                  BorderThickness="1"
                  IsVisible="{Binding HasFrame}">
            <StackPanel Spacing="10">

              <!-- Status label row — icon glyph so the state doesn't rely on color alone -->
              <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <TextBlock Text="{Binding Status, Converter={StaticResource StatusToLabel}, ConverterParameter=icon}"
                           FontSize="16"
                           FontWeight="Bold"
                           VerticalAlignment="Center"
                           Foreground="{Binding Status, Converter={StaticResource StatusToBrush}, ConverterParameter=accent}" />
                <TextBlock Text="{Binding Status, Converter={StaticResource StatusToLabel}}"
                           FontSize="13"
                           FontWeight="Bold"
                           LetterSpacing="2"
                           VerticalAlignment="Center"
                           Foreground="{Binding Status, Converter={StaticResource StatusToBrush}, ConverterParameter=accent}" />
              </StackPanel>

              <!-- Quality / guard message — large enough to read while posing away from the screen -->
              <TextBlock Text="{Binding PoseQuality}"
                         IsVisible="{Binding HasPoseQualityMessage}"
                         FontSize="22"
                         FontWeight="SemiBold"
                         Foreground="{StaticResource TextPrimary}"
                         TextWrapping="Wrap"
                         LineHeight="30" />

              <!-- Correction hints — bullets follow the status color, not the brand accent -->
              <ItemsControl ItemsSource="{Binding Hints}"
                            IsVisible="{Binding HasHints}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Spacing="8" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                      <Ellipse Width="7" Height="7"
                               Fill="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).Status, Converter={StaticResource StatusToBrush}, ConverterParameter=accent}"
                               VerticalAlignment="Top" Margin="0,10,0,0" />
                      <TextBlock Text="{Binding}"
                                 FontSize="19"
                                 FontWeight="SemiBold"
                                 Foreground="{StaticResource TextPrimary}"
                                 TextWrapping="Wrap"
                                 LineHeight="26" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

            </StackPanel>
          </Border>
        </Grid>
      </Border>

      <!-- RIGHT — Evaluation panel (similarity meter + reference) -->
      <Border Grid.Column="2"
              Background="{StaticResource SurfacePanel}"
              BorderBrush="{StaticResource AccentMuted}"
              BorderThickness="1,0,0,0">
        <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="20">

          <!-- Section header -->
          <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,16">
            <TextBlock Classes="panelTitle" Text="AVALIAÇÃO" />
            <TextBlock Classes="caption"
                       Text="Análise em tempo real"
                       FontWeight="Regular"
                       LetterSpacing="0" />
          </StackPanel>

          <!-- Similarity meter — the key metric, sized to be readable from across the room -->
          <StackPanel Grid.Row="1" Spacing="6" Margin="0,0,0,20">
            <TextBlock Text="SEMELHANÇA"
                       FontSize="11"
                       FontWeight="Bold"
                       Foreground="{StaticResource TextMuted}"
                       LetterSpacing="2" />
            <TextBlock Text="{Binding SimilarityPercent, StringFormat='{}{0}%'}"
                       FontSize="64"
                       FontWeight="Bold"
                       Foreground="{Binding Status, Converter={StaticResource StatusToBrush}, ConverterParameter=accent}" />
            <ProgressBar Minimum="0"
                         Maximum="1"
                         Value="{Binding Similarity}"
                         Height="8"
                         CornerRadius="4"
                         Background="{StaticResource Divider}"
                         Foreground="{Binding Status, Converter={StaticResource StatusToBrush}, ConverterParameter=accent}">
              <ProgressBar.Transitions>
                <Transitions>
                  <DoubleTransition Property="Value" Duration="0:0:0.15" Easing="CubicEaseOut" />
                </Transitions>
              </ProgressBar.Transitions>
            </ProgressBar>
          </StackPanel>

          <!-- Reference pose image — fills remaining space without cropping -->
          <Border Grid.Row="2"
                  CornerRadius="12"
                  Background="{StaticResource SurfaceCard}"
                  BorderBrush="{StaticResource AccentBorder}"
                  BorderThickness="1"
                  ClipToBounds="True">
            <Panel Opacity="{Binding ReferenceImageOpacity}">
              <Panel.Transitions>
                <Transitions>
                  <DoubleTransition Property="Opacity" Duration="0:0:0.18" Easing="CubicEaseInOut" />
                </Transitions>
              </Panel.Transitions>

              <!-- Uniform so the reference pose is never cropped — the user needs
                   to see the entire pose, not a zoomed crop of it. -->
              <Image IsVisible="{Binding HasReferenceImage}"
                     Source="{Binding ReferenceImage}"
                     Stretch="Uniform"
                     Margin="12"
                     HorizontalAlignment="Stretch"
                     VerticalAlignment="Stretch" />

              <!-- Placeholder when no reference image -->
              <StackPanel IsVisible="{Binding !HasReferenceImage}"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Spacing="10">
                <Border Width="48" Height="48" CornerRadius="24"
                        Background="#14EF4444" BorderBrush="{StaticResource AccentBorder}" BorderThickness="1"
                        HorizontalAlignment="Center">
                  <TextBlock Text="—" FontSize="22" FontWeight="Bold"
                             Foreground="{StaticResource Accent}"
                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="SEM REFERÊNCIA"
                           Classes="caption"
                           HorizontalAlignment="Center" />
                <TextBlock Text="Modo de enquadramento"
                           FontSize="12"
                           Foreground="{StaticResource TextMuted}"
                           HorizontalAlignment="Center" />
              </StackPanel>

            </Panel>
          </Border>

          <!-- Reference label — moved below the image so nothing is cropped -->
          <StackPanel Grid.Row="3" Spacing="4" Margin="0,16,0,0">
            <TextBlock Text="REFERÊNCIA"
                       FontSize="10"
                       FontWeight="Bold"
                       Foreground="{StaticResource Accent}"
                       LetterSpacing="3" />
            <TextBlock Text="{Binding SelectedPoseLabel}"
                       FontSize="14"
                       FontWeight="Bold"
                       Foreground="{StaticResource TextPrimary}"
                       LetterSpacing="1" />
          </StackPanel>

        </Grid>
      </Border>

    </Grid>

    <!-- ── Footer ───────────────────────────────────────────────────── -->
    <Border Grid.Row="2"
            Background="{StaticResource SurfaceBase}"
            BorderBrush="{StaticResource AccentMuted}"
            BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="Auto,*,Auto" Margin="24,0">
        <TextBlock Grid.Column="0"
                   Text="© 2026 Feral Tech Supplies"
                   FontSize="10"
                   Foreground="{StaticResource TextDisabled}"
                   VerticalAlignment="Center"
                   LetterSpacing="0.5" />
        <StackPanel Grid.Column="2"
                    Orientation="Horizontal"
                    Spacing="6"
                    VerticalAlignment="Center">
          <Ellipse Width="6" Height="6"
                   Fill="{Binding FpsIndicatorBrush}"
                   VerticalAlignment="Center" />
          <TextBlock Text="{Binding Fps, StringFormat='{}{0} FPS'}"
                     FontSize="10"
                     FontWeight="Bold"
                     Foreground="{StaticResource TextMuted}"
                     VerticalAlignment="Center"
                     LetterSpacing="1" />
        </StackPanel>
      </Grid>
    </Border>

  </Grid>
</Window>
