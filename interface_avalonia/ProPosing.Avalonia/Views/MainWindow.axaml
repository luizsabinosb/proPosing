<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:ProPosing.Avalonia.ViewModels"
        xmlns:converters="clr-namespace:ProPosing.Avalonia.Converters"
        xmlns:controls="clr-namespace:ProPosing.Avalonia.Views.Controls"
        x:Class="ProPosing.Avalonia.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="proPosing"
        Width="1600"
        Height="920"
        MinWidth="1280"
        MinHeight="720"
        Background="#0A0A0A"
        KeyDown="OnWindowKeyDown"
        mc:Ignorable="d">

  <Window.Resources>
    <converters:StatusToLabelConverter x:Key="StatusToLabel" />
    <converters:StatusToBrushConverter x:Key="StatusToBrush" />
    <converters:PoseModeMatchToBrushConverter x:Key="PoseModeMatchToBrush" />
  </Window.Resources>

  <!-- Root: top branding bar + main content + footer -->
  <Grid RowDefinitions="52,*,28">

    <!-- ── Top branding bar ─────────────────────────────────────────── -->
    <Border Grid.Row="0" Background="#0A0A0A">
      <Border BorderBrush="#33EF4444" BorderThickness="0,0,0,1">
        <Grid ColumnDefinitions="*,Auto" Margin="20,0">
          <StackPanel Orientation="Horizontal"
                      VerticalAlignment="Center"
                      Spacing="0">
            <TextBlock Text="pro"
                       FontFamily="Ethnocentric"
                       FontSize="22"
                       FontWeight="Bold"
                       FontStyle="Italic"
                       Foreground="White" />
            <TextBlock Text="Posing"
                       FontFamily="Ethnocentric"
                       FontSize="22"
                       FontWeight="Bold"
                       Foreground="#EF4444" />
          </StackPanel>
          <TextBlock Grid.Column="1"
                     Text="Powered by Feral Tech Supplies"
                     FontSize="12"
                     FontStyle="Italic"
                     Foreground="#55FFFFFF"
                     VerticalAlignment="Center"
                     Margin="0,0,4,0" />
        </Grid>
      </Border>
    </Border>

    <!-- ── Main 3-column layout ─────────────────────────────────────── -->
    <Grid Grid.Row="1" ColumnDefinitions="260,*,440">

      <!-- LEFT — Poses panel -->
      <Border Grid.Column="0" Background="#0D0D0D" BorderBrush="#22EF4444" BorderThickness="0,0,1,0">
        <Grid RowDefinitions="Auto,*,56">

          <!-- Poses header -->
          <Border Grid.Row="0" Padding="16,14">
            <StackPanel Spacing="4">
              <TextBlock Classes="panelTitle" Text="SELEÇÃO DE POSE" />
              <TextBlock Text="Teclas 0 – 9 para trocar" Foreground="#55FFFFFF" FontSize="11" />
            </StackPanel>
          </Border>

          <!-- Pose buttons -->
          <ScrollViewer Grid.Row="1" Margin="10,0,10,10" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="8">

              <!-- 0 — Enquadramento -->
              <Button Classes="pose"
                      Background="{Binding SelectedPoseMode, Converter={StaticResource PoseModeMatchToBrush}, ConverterParameter=enquadramento|background}"
                      BorderBrush="{Binding SelectedPoseMode, Converter={StaticResource PoseModeMatchToBrush}, ConverterParameter=enquadramento|border}"
                      Command="{Binding SelectPoseCommand}"
                      CommandParameter="enquadramento">
                <Grid ColumnDefinitions="36,*" VerticalAlignment="Center">
                  <Border Grid.Column="0" Width="26" Height="26" Background="#22EF4444"
                          BorderBrush="#55EF4444" BorderThickness="1" CornerRadius="6"
                          HorizontalAlignment="Left" VerticalAlignment="Center">
                    <TextBlock Text="0" FontSize="12" FontWeight="Bold" Foreground="#EF4444"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <TextBlock Grid.Column="1" Text="ENQUADRAMENTO" FontSize="13" FontWeight="Bold"
                             Foreground="White" VerticalAlignment="Center" />
                </Grid>
              </Button>

              <!-- 1 — Duplo Bíceps -->
              <Button Classes="pose"
                      Background="{Binding SelectedPoseMode, Converter={StaticResource PoseModeMatchToBrush}, ConverterParameter=double_biceps|background}"
                      BorderBrush="{Binding SelectedPoseMode, Converter={StaticResource PoseModeMatchToBrush}, ConverterParameter=double_biceps|border}"
                      Command="{Binding SelectPoseCommand}"
                      CommandParameter="double_biceps">
                <Grid ColumnDefinitions="36,*" VerticalAlignment="Center">
                  <Border Grid.Column="0" Width="26" Height="26" Background="#22EF4444"
                          BorderBrush="#55EF4444" BorderThickness="1" CornerRadius="6"
                          HorizontalAlignment="Left" VerticalAlignment="Center">
                    <TextBlock Text="1" FontSize="12" FontWeight="Bold" Foreground="#EF4444"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <TextBlock Grid.Column="1" Text="DUPLO BÍCEPS" FontSize="13" FontWeight="Bold"
                             Foreground="White" VerticalAlignment="Center" />
                </Grid>
              </Button>

              <!-- 2 — Side Chest -->
              <Button Classes="pose"
                      Background="{Binding SelectedPoseMode, Converter={StaticResource PoseModeMatchToBrush}, ConverterParameter=side_chest|background}"
                      BorderBrush="{Binding SelectedPoseMode, Converter={StaticResource PoseModeMatchToBrush}, ConverterParameter=side_chest|border}"
                      Command="{Binding SelectPoseCommand}"
                      CommandParameter="side_chest">
                <Grid ColumnDefinitions="36,*" VerticalAlignment="Center">
                  <Border Grid.Column="0" Width="26" Height="26" Background="#22EF4444"
                          BorderBrush="#55EF4444" BorderThickness="1" CornerRadius="6"
                          HorizontalAlignment="Left" VerticalAlignment="Center">
                    <TextBlock Text="2" FontSize="12" FontWeight="Bold" Foreground="#EF4444"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <TextBlock Grid.Column="1" Text="SIDE CHEST" FontSize="13" FontWeight="Bold"
                             Foreground="White" VerticalAlignment="Center" />
                </Grid>
              </Button>

              <!-- 3 — Side Tríceps -->
              <Button Classes="pose"
                      Background="{Binding SelectedPoseMode, Converter={StaticResource PoseModeMatchToBrush}, ConverterParameter=side_triceps|background}"
                      BorderBrush="{Binding SelectedPoseMode, Converter={StaticResource PoseModeMatchToBrush}, ConverterParameter=side_triceps|border}"
                      Command="{Binding SelectPoseCommand}"
                      CommandParameter="side_triceps">
                <Grid ColumnDefinitions="36,*" VerticalAlignment="Center">
                  <Border Grid.Column="0" Width="26" Height="26" Background="#22EF4444"
                          BorderBrush="#55EF4444" BorderThickness="1" CornerRadius="6"
                          HorizontalAlignment="Left" VerticalAlignment="Center">
                    <TextBlock Text="3" FontSize="12" FontWeight="Bold" Foreground="#EF4444"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <TextBlock Grid.Column="1" Text="SIDE TRÍCEPS" FontSize="13" FontWeight="Bold"
                             Foreground="White" VerticalAlignment="Center" />
                </Grid>
              </Button>

              <!-- 4 — Most Muscular -->
              <Button Classes="pose"
                      Background="{Binding SelectedPoseMode, Converter={StaticResource PoseModeMatchToBrush}, ConverterParameter=most_muscular|background}"
                      BorderBrush="{Binding SelectedPoseMode, Converter={StaticResource PoseModeMatchToBrush}, ConverterParameter=most_muscular|border}"
                      Command="{Binding SelectPoseCommand}"
                      CommandParameter="most_muscular">
                <Grid ColumnDefinitions="36,*" VerticalAlignment="Center">
                  <Border Grid.Column="0" Width="26" Height="26" Background="#22EF4444"
                          BorderBrush="#55EF4444" BorderThickness="1" CornerRadius="6"
                          HorizontalAlignment="Left" VerticalAlignment="Center">
                    <TextBlock Text="4" FontSize="12" FontWeight="Bold" Foreground="#EF4444"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <TextBlock Grid.Column="1" Text="MOST MUSCULAR" FontSize="13" FontWeight="Bold"
                             Foreground="White" VerticalAlignment="Center" />
                </Grid>
              </Button>

              <!-- 5 — Quarter Turn -->
              <Button Classes="pose"
                      Background="{Binding SelectedPoseMode, Converter={StaticResource PoseModeMatchToBrush}, ConverterParameter=quarter_turn_side|background}"
                      BorderBrush="{Binding SelectedPoseMode, Converter={StaticResource PoseModeMatchToBrush}, ConverterParameter=quarter_turn_side|border}"
                      Command="{Binding SelectPoseCommand}"
                      CommandParameter="quarter_turn_side">
                <Grid ColumnDefinitions="36,*" VerticalAlignment="Center">
                  <Border Grid.Column="0" Width="26" Height="26" Background="#22EF4444"
                          BorderBrush="#55EF4444" BorderThickness="1" CornerRadius="6"
                          HorizontalAlignment="Left" VerticalAlignment="Center">
                    <TextBlock Text="5" FontSize="12" FontWeight="Bold" Foreground="#EF4444"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <TextBlock Grid.Column="1" Text="QUARTER TURN" FontSize="13" FontWeight="Bold"
                             Foreground="White" VerticalAlignment="Center" />
                </Grid>
              </Button>

              <!-- 6 — Front Lat Spread -->
              <Button Classes="pose"
                      Background="{Binding SelectedPoseMode, Converter={StaticResource PoseModeMatchToBrush}, ConverterParameter=front_lat_spread|background}"
                      BorderBrush="{Binding SelectedPoseMode, Converter={StaticResource PoseModeMatchToBrush}, ConverterParameter=front_lat_spread|border}"
                      Command="{Binding SelectPoseCommand}"
                      CommandParameter="front_lat_spread">
                <Grid ColumnDefinitions="36,*" VerticalAlignment="Center">
                  <Border Grid.Column="0" Width="26" Height="26" Background="#22EF4444"
                          BorderBrush="#55EF4444" BorderThickness="1" CornerRadius="6"
                          HorizontalAlignment="Left" VerticalAlignment="Center">
                    <TextBlock Text="6" FontSize="12" FontWeight="Bold" Foreground="#EF4444"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <TextBlock Grid.Column="1" Text="FRONT LAT SPREAD" FontSize="13" FontWeight="Bold"
                             Foreground="White" VerticalAlignment="Center" />
                </Grid>
              </Button>

              <!-- 7 — Back Lat Spread -->
              <Button Classes="pose"
                      Background="{Binding SelectedPoseMode, Converter={StaticResource PoseModeMatchToBrush}, ConverterParameter=back_lat_spread|background}"
                      BorderBrush="{Binding SelectedPoseMode, Converter={StaticResource PoseModeMatchToBrush}, ConverterParameter=back_lat_spread|border}"
                      Command="{Binding SelectPoseCommand}"
                      CommandParameter="back_lat_spread">
                <Grid ColumnDefinitions="36,*" VerticalAlignment="Center">
                  <Border Grid.Column="0" Width="26" Height="26" Background="#22EF4444"
                          BorderBrush="#55EF4444" BorderThickness="1" CornerRadius="6"
                          HorizontalAlignment="Left" VerticalAlignment="Center">
                    <TextBlock Text="7" FontSize="12" FontWeight="Bold" Foreground="#EF4444"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <TextBlock Grid.Column="1" Text="BACK LAT SPREAD" FontSize="13" FontWeight="Bold"
                             Foreground="White" VerticalAlignment="Center" />
                </Grid>
              </Button>

              <!-- 8 — Abs and Thighs -->
              <Button Classes="pose"
                      Background="{Binding SelectedPoseMode, Converter={StaticResource PoseModeMatchToBrush}, ConverterParameter=abs_and_thighs|background}"
                      BorderBrush="{Binding SelectedPoseMode, Converter={StaticResource PoseModeMatchToBrush}, ConverterParameter=abs_and_thighs|border}"
                      Command="{Binding SelectPoseCommand}"
                      CommandParameter="abs_and_thighs">
                <Grid ColumnDefinitions="36,*" VerticalAlignment="Center">
                  <Border Grid.Column="0" Width="26" Height="26" Background="#22EF4444"
                          BorderBrush="#55EF4444" BorderThickness="1" CornerRadius="6"
                          HorizontalAlignment="Left" VerticalAlignment="Center">
                    <TextBlock Text="8" FontSize="12" FontWeight="Bold" Foreground="#EF4444"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <TextBlock Grid.Column="1" Text="ABS AND THIGHS" FontSize="13" FontWeight="Bold"
                             Foreground="White" VerticalAlignment="Center" />
                </Grid>
              </Button>

              <!-- 9 — Tea Cup -->
              <Button Classes="pose"
                      Background="{Binding SelectedPoseMode, Converter={StaticResource PoseModeMatchToBrush}, ConverterParameter=teacup|background}"
                      BorderBrush="{Binding SelectedPoseMode, Converter={StaticResource PoseModeMatchToBrush}, ConverterParameter=teacup|border}"
                      Command="{Binding SelectPoseCommand}"
                      CommandParameter="teacup">
                <Grid ColumnDefinitions="36,*" VerticalAlignment="Center">
                  <Border Grid.Column="0" Width="26" Height="26" Background="#22EF4444"
                          BorderBrush="#55EF4444" BorderThickness="1" CornerRadius="6"
                          HorizontalAlignment="Left" VerticalAlignment="Center">
                    <TextBlock Text="9" FontSize="12" FontWeight="Bold" Foreground="#EF4444"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <TextBlock Grid.Column="1" Text="TEA CUP" FontSize="13" FontWeight="Bold"
                             Foreground="White" VerticalAlignment="Center" />
                </Grid>
              </Button>

            </StackPanel>
          </ScrollViewer>

          <!-- FPS indicator 
          <Border Grid.Row="2"
                  Background="#0A0A0A"
                  BorderBrush="#22EF4444"
                  BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="8">
              <Ellipse Width="8" Height="8" Fill="{Binding FpsIndicatorBrush}" />
              <TextBlock Text="{Binding Fps, StringFormat='FPS: {0}'}"
                         FontSize="16" FontWeight="Bold" />
            </StackPanel>
          </Border>-->

        </Grid>
      </Border>

      <!-- CENTER — Camera feed -->
      <Border Grid.Column="1" Background="Black">
        <Grid>
          <Image Source="{Binding CameraFrame}" Stretch="Uniform" />
          <controls:SkeletonOverlayControl Landmarks="{Binding Landmarks}"
                                           Status="{Binding Status}"
                                           ImageWidth="{Binding ImageWidth}"
                                           ImageHeight="{Binding ImageHeight}" />

          <!-- Placeholder when camera is off / waiting / error -->
          <Border Background="#00000000" IsVisible="{Binding ShowPlaceholder}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="20" MaxWidth="420">

              <!-- Waiting for permission state -->
              <StackPanel IsVisible="{Binding HasCameraStatusMessage}" Spacing="12" HorizontalAlignment="Center">
                <TextBlock Text="📷"
                           FontSize="40"
                           HorizontalAlignment="Center" />
                <TextBlock Text="{Binding CameraStatusMessage}"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="#CCFFFFFF"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           LineHeight="24" />
              </StackPanel>

              <!-- Idle state (no error, no status message) -->
              <TextBlock IsVisible="{Binding !HasCameraStatusMessage}"
                         Text="Inicializando câmera..."
                         FontSize="18"
                         Foreground="#50FFFFFF"
                         HorizontalAlignment="Center" />

              <!-- Error state -->
              <Border IsVisible="{Binding HasCameraError}"
                      Background="#1AEF4444"
                      BorderBrush="#44EF4444"
                      BorderThickness="1"
                      CornerRadius="10"
                      Padding="20,16">
                <StackPanel Spacing="12">
                  <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                    <TextBlock Text="⚠" FontSize="16" Foreground="#EF4444" VerticalAlignment="Center" />
                    <TextBlock Text="Câmera indisponível"
                               FontSize="15"
                               FontWeight="Bold"
                               Foreground="#EF4444"
                               VerticalAlignment="Center" />
                  </StackPanel>
                  <TextBlock Text="{Binding CameraError}"
                             Foreground="#DDFFFFFF"
                             FontSize="13"
                             HorizontalAlignment="Center"
                             TextAlignment="Center"
                             TextWrapping="Wrap"
                             LineHeight="20" />
                  <Button Content="Tentar novamente"
                          Command="{Binding StartCameraCommand}"
                          HorizontalAlignment="Center"
                          Margin="0,4,0,0" />
                </StackPanel>
              </Border>

            </StackPanel>
          </Border>
        </Grid>
      </Border>

      <!-- RIGHT — Evaluation panel -->
      <Border Grid.Column="2" Background="#0D0D0D" BorderBrush="#22EF4444" BorderThickness="1,0,0,0">
        <Grid RowDefinitions="Auto,*" Margin="16,16,16,16">

          <!-- TOP: header + feedback card + stats -->
          <StackPanel Grid.Row="0" Spacing="12">

            <!-- Section header -->
            <TextBlock Text="AVALIAÇÃO" Classes="panelTitle" Margin="0,0,0,4"
                       HorizontalAlignment="Center" TextAlignment="Center" />

            <!-- ── Single feedback card ──────────────────────────────── -->
            <Border CornerRadius="12"
                    Background="{Binding Status, Converter={StaticResource StatusToBrush}}"
                    BorderBrush="{Binding Status, Converter={StaticResource StatusToBrush}, ConverterParameter=border}"
                    BorderThickness="1"
                    Padding="16,14">
              <StackPanel Spacing="10">

                <!-- Status label row -->
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                  <Ellipse Width="8" Height="8"
                           Fill="{Binding Status, Converter={StaticResource StatusToBrush}, ConverterParameter=accent}" />
                  <TextBlock Text="{Binding Status, Converter={StaticResource StatusToLabel}}"
                             FontSize="11"
                             FontWeight="Bold"
                             Foreground="{Binding Status, Converter={StaticResource StatusToBrush}, ConverterParameter=accent}" />
                </StackPanel>

                <!-- Thin divider -->
                <Border Height="1" Background="#18FFFFFF" />

                <!-- Standalone message: success text OR single early-return guard message -->
                <TextBlock Text="{Binding PoseQuality}"
                           IsVisible="{Binding HasPoseQualityMessage}"
                           FontSize="17"
                           FontWeight="SemiBold"
                           Foreground="White"
                           TextWrapping="Wrap"
                           LineHeight="24" />

                <!-- All correction hints — uniform style and size -->
                <ItemsControl ItemsSource="{Binding Hints}"
                              IsVisible="{Binding HasHints}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Classes="hint">
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                          <Ellipse Width="7" Height="7"
                                   Fill="#EF4444"
                                   VerticalAlignment="Center" />
                          <TextBlock Text="{Binding}"
                                     FontSize="17"
                                     FontWeight="SemiBold"
                                     Foreground="#EEFFFFFF"
                                     TextWrapping="Wrap"
                                     LineHeight="22"
                                     VerticalAlignment="Center" />
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

              </StackPanel>
            </Border>

          </StackPanel>

          <!-- BOTTOM: Reference pose image — fills remaining space -->
          <Border Grid.Row="1"
                  CornerRadius="12"
                  Background="#111111"
                  BorderBrush="#2AEF4444"
                  BorderThickness="1"
                  ClipToBounds="True"
                  Margin="0,12,0,0">
            <Panel Opacity="{Binding ReferenceImageOpacity}">
              <Panel.Transitions>
                <Transitions>
                  <DoubleTransition Property="Opacity" Duration="0:0:0.18" Easing="CubicEaseInOut" />
                </Transitions>
              </Panel.Transitions>

              <!-- Image available -->
              <Grid IsVisible="{Binding HasReferenceImage}">
                <Image Source="{Binding ReferenceImage}"
                       Stretch="UniformToFill"
                       Opacity="0.82"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />

                <!-- Top fade / vignette -->
                <Border VerticalAlignment="Top" Height="56">
                  <Border.Background>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                      <GradientStop Offset="0" Color="#DD111111" />
                      <GradientStop Offset="1" Color="#00111111" />
                    </LinearGradientBrush>
                  </Border.Background>
                </Border>

                <!-- Bottom overlay with label -->
                <Border VerticalAlignment="Bottom" Padding="14,10">
                  <Border.Background>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                      <GradientStop Offset="0" Color="#00111111" />
                      <GradientStop Offset="1" Color="#EE111111" />
                    </LinearGradientBrush>
                  </Border.Background>
                  <StackPanel Spacing="2">
                    <TextBlock Text="REFERÊNCIA"
                               FontSize="10"
                               FontWeight="Bold"
                               Foreground="#55EF4444"
                               LetterSpacing="2" />
                    <TextBlock Text="{Binding SelectedPoseLabel}"
                               FontSize="13"
                               FontWeight="Bold"
                               Foreground="#CCFFFFFF"
                               LetterSpacing="1" />
                  </StackPanel>
                </Border>

                <!-- Thin red accent line at bottom -->
                <Border VerticalAlignment="Bottom"
                        Height="2"
                        Background="#66EF4444"
                        HorizontalAlignment="Stretch" />
              </Grid>

              <!-- Placeholder when no reference (e.g. enquadramento) -->
              <StackPanel IsVisible="{Binding !HasReferenceImage}"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Spacing="8">
                <TextBlock Text="SEM REFERÊNCIA"
                           FontSize="11"
                           FontWeight="Bold"
                           Foreground="#33FFFFFF"
                           HorizontalAlignment="Center"
                           LetterSpacing="2" />
                <TextBlock Text="Modo de enquadramento"
                           FontSize="11"
                           Foreground="#22FFFFFF"
                           HorizontalAlignment="Center" />
              </StackPanel>

            </Panel>
          </Border>

        </Grid>
      </Border>

    </Grid>

    <!-- ── Footer ───────────────────────────────────────────────────── -->
    <Border Grid.Row="2" Background="#0A0A0A" BorderBrush="#18EF4444" BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="*,Auto" Margin="16,0">
        <TextBlock Grid.Column="0"
                   Text="© 2026 Feral Tech Supplies · All rights reserved."
                   FontSize="10"
                   FontStyle="Italic"
                   Foreground="#22FFFFFF"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center" />
        <StackPanel Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="5"
                    VerticalAlignment="Center">
          <Ellipse Width="6" Height="6"
                   Fill="{Binding FpsIndicatorBrush}"
                   VerticalAlignment="Center" />
          <TextBlock Text="{Binding Fps, StringFormat='{}{0} FPS'}"
                     FontSize="10"
                     FontWeight="Bold"
                     Foreground="#44FFFFFF"
                     VerticalAlignment="Center" />
        </StackPanel>
      </Grid>
    </Border>

  </Grid>
</Window>
