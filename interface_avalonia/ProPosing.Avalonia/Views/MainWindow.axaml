<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:ProPosing.Avalonia.ViewModels"
        xmlns:converters="clr-namespace:ProPosing.Avalonia.Converters"
        xmlns:controls="clr-namespace:ProPosing.Avalonia.Views.Controls"
        x:Class="ProPosing.Avalonia.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="proPosing"
        Width="1600"
        Height="920"
        MinWidth="1280"
        MinHeight="720"
        Background="{StaticResource SurfaceBase}"
        KeyDown="OnWindowKeyDown"
        mc:Ignorable="d">

  <Window.Resources>
    <converters:StatusToLabelConverter x:Key="StatusToLabel" />
    <converters:StatusToBrushConverter x:Key="StatusToBrush" />
  </Window.Resources>

  <!-- Root: top bar + main content + footer -->
  <Grid RowDefinitions="56,*,32">

    <!-- ── Top branding bar ─────────────────────────────────────────── -->
    <Border Grid.Row="0"
            Background="{StaticResource SurfaceBase}"
            BorderBrush="{StaticResource AccentMuted}"
            BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="*,Auto" Margin="24,0">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="0">
          <TextBlock Text="pro"
                     FontFamily="{StaticResource DisplayFont}"
                     FontSize="22"
                     FontWeight="Bold"
                     FontStyle="Italic"
                     Foreground="White" />
          <TextBlock Text="Posing"
                     FontFamily="{StaticResource DisplayFont}"
                     FontSize="22"
                     FontWeight="Bold"
                     Foreground="{StaticResource Accent}" />
        </StackPanel>
        <TextBlock Grid.Column="1"
                   Text="Powered by Feral Tech Supplies"
                   FontSize="11"
                   FontStyle="Italic"
                   Foreground="{StaticResource TextMuted}"
                   VerticalAlignment="Center"
                   LetterSpacing="0.5" />
      </Grid>
    </Border>

    <!-- ── Main 3-column layout ─────────────────────────────────────── -->
    <Grid Grid.Row="1" ColumnDefinitions="260,*,440">

      <!-- LEFT — Poses panel -->
      <Border Grid.Column="0"
              Background="{StaticResource SurfacePanel}"
              BorderBrush="{StaticResource AccentMuted}"
              BorderThickness="0,0,1,0">
        <Grid RowDefinitions="Auto,*">

          <StackPanel Grid.Row="0" Spacing="4" Margin="20,20,20,16">
            <TextBlock Classes="panelTitle" Text="POSES" />
            <TextBlock Classes="caption"
                       Text="Teclas 0–9 para trocar"
                       FontWeight="Regular"
                       LetterSpacing="0" />
          </StackPanel>

          <ScrollViewer Grid.Row="1"
                        Padding="12,0,12,16"
                        VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Poses}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Spacing="8" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Classes="pose"
                          Classes.selected="{Binding IsSelected}"
                          Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).SelectPoseCommand}"
                          CommandParameter="{Binding Mode}">
                    <Grid ColumnDefinitions="36,*" VerticalAlignment="Center">
                      <Border Grid.Column="0" Classes="poseChip">
                        <TextBlock Text="{Binding Number}" />
                      </Border>
                      <TextBlock Grid.Column="1"
                                 Classes="poseLabel"
                                 Text="{Binding Label}" />
                    </Grid>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>

        </Grid>
      </Border>

      <!-- CENTER — Camera feed -->
      <Border Grid.Column="1" Background="Black">
        <Grid>
          <Image Source="{Binding CameraFrame}" Stretch="Uniform" />
          <controls:SkeletonOverlayControl Landmarks="{Binding Landmarks}"
                                           Status="{Binding Status}"
                                           ImageWidth="{Binding ImageWidth}"
                                           ImageHeight="{Binding ImageHeight}" />

          <!-- Placeholder when camera is off / waiting / error -->
          <Border IsVisible="{Binding ShowPlaceholder}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                        Spacing="20" MaxWidth="420">

              <!-- Waiting for permission -->
              <StackPanel IsVisible="{Binding HasCameraStatusMessage}"
                          Spacing="14" HorizontalAlignment="Center">
                <TextBlock Text="📷" FontSize="44" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding CameraStatusMessage}"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimary}"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           LineHeight="24" />
              </StackPanel>

              <!-- Idle -->
              <TextBlock IsVisible="{Binding !HasCameraStatusMessage}"
                         Text="Inicializando câmera..."
                         FontSize="15"
                         Foreground="{StaticResource TextMuted}"
                         HorizontalAlignment="Center" />

              <!-- Error -->
              <Border IsVisible="{Binding HasCameraError}"
                      Background="#14EF4444"
                      BorderBrush="{StaticResource AccentBorder}"
                      BorderThickness="1"
                      CornerRadius="12"
                      Padding="20,16">
                <StackPanel Spacing="12">
                  <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                    <TextBlock Text="⚠" FontSize="16" Foreground="{StaticResource Accent}" VerticalAlignment="Center" />
                    <TextBlock Text="Câmera indisponível"
                               FontSize="14"
                               FontWeight="Bold"
                               Foreground="{StaticResource Accent}"
                               VerticalAlignment="Center"
                               LetterSpacing="0.5" />
                  </StackPanel>
                  <TextBlock Text="{Binding CameraError}"
                             Foreground="{StaticResource TextSecondary}"
                             FontSize="13"
                             HorizontalAlignment="Center"
                             TextAlignment="Center"
                             TextWrapping="Wrap"
                             LineHeight="20" />
                  <Button Classes="loginBtn"
                          Content="Tentar novamente"
                          Command="{Binding StartCameraCommand}"
                          HorizontalAlignment="Center"
                          MinWidth="160"
                          Height="40"
                          Margin="0,4,0,0" />
                </StackPanel>
              </Border>

            </StackPanel>
          </Border>
        </Grid>
      </Border>

      <!-- RIGHT — Evaluation panel -->
      <Border Grid.Column="2"
              Background="{StaticResource SurfacePanel}"
              BorderBrush="{StaticResource AccentMuted}"
              BorderThickness="1,0,0,0">
        <Grid RowDefinitions="Auto,Auto,*" Margin="20">

          <!-- Section header -->
          <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,16">
            <TextBlock Classes="panelTitle" Text="AVALIAÇÃO" />
            <TextBlock Classes="caption"
                       Text="Análise em tempo real"
                       FontWeight="Regular"
                       LetterSpacing="0" />
          </StackPanel>

          <!-- Feedback card -->
          <Border Grid.Row="1"
                  CornerRadius="12"
                  Background="{Binding Status, Converter={StaticResource StatusToBrush}}"
                  BorderBrush="{Binding Status, Converter={StaticResource StatusToBrush}, ConverterParameter=border}"
                  BorderThickness="1"
                  Padding="18,16">
            <StackPanel Spacing="12">

              <!-- Status label row -->
              <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Ellipse Width="8" Height="8"
                         Fill="{Binding Status, Converter={StaticResource StatusToBrush}, ConverterParameter=accent}" />
                <TextBlock Text="{Binding Status, Converter={StaticResource StatusToLabel}}"
                           FontSize="11"
                           FontWeight="Bold"
                           LetterSpacing="2"
                           Foreground="{Binding Status, Converter={StaticResource StatusToBrush}, ConverterParameter=accent}" />
              </StackPanel>

              <Border Height="1" Background="{StaticResource Divider}" />

              <!-- Success or guard message -->
              <TextBlock Text="{Binding PoseQuality}"
                         IsVisible="{Binding HasPoseQualityMessage}"
                         FontSize="16"
                         FontWeight="SemiBold"
                         Foreground="{StaticResource TextPrimary}"
                         TextWrapping="Wrap"
                         LineHeight="24" />

              <!-- Correction hints -->
              <ItemsControl ItemsSource="{Binding Hints}"
                            IsVisible="{Binding HasHints}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Spacing="8" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Classes="hint">
                      <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <Ellipse Width="7" Height="7" Fill="{StaticResource Accent}" VerticalAlignment="Top" Margin="0,7,0,0" />
                        <TextBlock Text="{Binding}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}"
                                   TextWrapping="Wrap"
                                   LineHeight="20" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

            </StackPanel>
          </Border>

          <!-- Reference pose image — fills remaining space -->
          <Border Grid.Row="2"
                  CornerRadius="12"
                  Background="{StaticResource SurfaceCard}"
                  BorderBrush="{StaticResource AccentBorder}"
                  BorderThickness="1"
                  ClipToBounds="True"
                  Margin="0,16,0,0">
            <Panel Opacity="{Binding ReferenceImageOpacity}">
              <Panel.Transitions>
                <Transitions>
                  <DoubleTransition Property="Opacity" Duration="0:0:0.18" Easing="CubicEaseInOut" />
                </Transitions>
              </Panel.Transitions>

              <!-- Image available -->
              <Grid IsVisible="{Binding HasReferenceImage}">
                <Image Source="{Binding ReferenceImage}"
                       Stretch="UniformToFill"
                       Opacity="0.85"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />

                <!-- Top fade -->
                <Border VerticalAlignment="Top" Height="64">
                  <Border.Background>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                      <GradientStop Offset="0" Color="#DD111111" />
                      <GradientStop Offset="1" Color="#00111111" />
                    </LinearGradientBrush>
                  </Border.Background>
                </Border>

                <!-- Bottom label overlay -->
                <Border VerticalAlignment="Bottom" Padding="16,12,16,14">
                  <Border.Background>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                      <GradientStop Offset="0" Color="#00111111" />
                      <GradientStop Offset="1" Color="#EE111111" />
                    </LinearGradientBrush>
                  </Border.Background>
                  <StackPanel Spacing="4">
                    <TextBlock Text="REFERÊNCIA"
                               FontSize="10"
                               FontWeight="Bold"
                               Foreground="{StaticResource Accent}"
                               LetterSpacing="3" />
                    <TextBlock Text="{Binding SelectedPoseLabel}"
                               FontSize="14"
                               FontWeight="Bold"
                               Foreground="White"
                               LetterSpacing="1" />
                  </StackPanel>
                </Border>

                <Border VerticalAlignment="Bottom"
                        Height="2"
                        Background="{StaticResource Accent}"
                        HorizontalAlignment="Stretch" />
              </Grid>

              <!-- Placeholder when no reference image -->
              <StackPanel IsVisible="{Binding !HasReferenceImage}"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Spacing="10">
                <Border Width="48" Height="48" CornerRadius="24"
                        Background="#14EF4444" BorderBrush="{StaticResource AccentBorder}" BorderThickness="1"
                        HorizontalAlignment="Center">
                  <TextBlock Text="—" FontSize="22" FontWeight="Bold"
                             Foreground="{StaticResource Accent}"
                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="SEM REFERÊNCIA"
                           Classes="caption"
                           HorizontalAlignment="Center" />
                <TextBlock Text="Modo de enquadramento"
                           FontSize="12"
                           Foreground="{StaticResource TextMuted}"
                           HorizontalAlignment="Center" />
              </StackPanel>

            </Panel>
          </Border>

        </Grid>
      </Border>

    </Grid>

    <!-- ── Footer ───────────────────────────────────────────────────── -->
    <Border Grid.Row="2"
            Background="{StaticResource SurfaceBase}"
            BorderBrush="{StaticResource AccentMuted}"
            BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="Auto,*,Auto" Margin="24,0">
        <TextBlock Grid.Column="0"
                   Text="© 2026 Feral Tech Supplies"
                   FontSize="10"
                   Foreground="{StaticResource TextDisabled}"
                   VerticalAlignment="Center"
                   LetterSpacing="0.5" />
        <StackPanel Grid.Column="2"
                    Orientation="Horizontal"
                    Spacing="6"
                    VerticalAlignment="Center">
          <Ellipse Width="6" Height="6"
                   Fill="{Binding FpsIndicatorBrush}"
                   VerticalAlignment="Center" />
          <TextBlock Text="{Binding Fps, StringFormat='{}{0} FPS'}"
                     FontSize="10"
                     FontWeight="Bold"
                     Foreground="{StaticResource TextMuted}"
                     VerticalAlignment="Center"
                     LetterSpacing="1" />
        </StackPanel>
      </Grid>
    </Border>

  </Grid>
</Window>
