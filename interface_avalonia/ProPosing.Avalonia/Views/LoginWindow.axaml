<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ProPosing.Avalonia.ViewModels"
        x:Class="ProPosing.Avalonia.Views.LoginWindow"
        x:DataType="vm:LoginViewModel"
        Title="proPosing"
        Width="440"
        Height="620"
        CanResize="False"
        Background="{StaticResource SurfaceBase}"
        WindowStartupLocation="CenterScreen"
        KeyDown="OnKeyDown">

  <Grid RowDefinitions="48,*,40">

    <!-- ── Top bar ──────────────────────────────────────────────── -->
    <Border Grid.Row="0"
            Background="{StaticResource SurfaceBase}"
            BorderBrush="{StaticResource AccentMuted}"
            BorderThickness="0,0,0,1">
      <TextBlock Text="Powered by Feral Tech Supplies"
                 FontSize="11"
                 FontStyle="Italic"
                 Foreground="{StaticResource TextMuted}"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 LetterSpacing="0.5" />
    </Border>

    <!-- ── Login form ───────────────────────────────────────────── -->
    <StackPanel Grid.Row="1"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Width="360"
                Spacing="0">

      <!-- Heading -->
      <StackPanel HorizontalAlignment="Center" Spacing="8" Margin="0,0,0,32">
        <TextBlock Text="BEM-VINDO AO"
                   Classes="caption"
                   HorizontalAlignment="Center" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="0">
          <TextBlock Text="pro"
                     FontFamily="{StaticResource DisplayFont}"
                     FontSize="32"
                     FontWeight="Bold"
                     FontStyle="Italic"
                     Foreground="White" />
          <TextBlock Text="Posing"
                     FontFamily="{StaticResource DisplayFont}"
                     FontSize="32"
                     FontWeight="Bold"
                     Foreground="{StaticResource Accent}" />
        </StackPanel>
        <TextBlock Text="Entre com suas credenciais para continuar"
                   FontSize="13"
                   Foreground="{StaticResource TextSecondary}"
                   HorizontalAlignment="Center"
                   Margin="0,4,0,0" />
      </StackPanel>

      <!-- Card -->
      <Border CornerRadius="14"
              Background="{StaticResource SurfaceCard}"
              BorderBrush="{StaticResource AccentBorder}"
              BorderThickness="1"
              ClipToBounds="True">
        <Grid RowDefinitions="3,Auto">

          <Border Grid.Row="0" Background="{StaticResource Accent}" />

          <StackPanel Grid.Row="1" Margin="28,26,28,28" Spacing="18">

            <StackPanel Spacing="8">
              <TextBlock Text="EMAIL"
                         FontSize="10"
                         FontWeight="Bold"
                         Foreground="{StaticResource TextMuted}"
                         LetterSpacing="2" />
              <TextBox Classes="loginField"
                       Name="EmailBox"
                       Text="{Binding Email}"
                       Watermark="seu@email.com" />
            </StackPanel>

            <StackPanel Spacing="8">
              <TextBlock Text="SENHA"
                         FontSize="10"
                         FontWeight="Bold"
                         Foreground="{StaticResource TextMuted}"
                         LetterSpacing="2" />
              <TextBox Classes="loginField"
                       Name="PasswordBox"
                       Text="{Binding Password}"
                       PasswordChar="•"
                       Watermark="••••••••" />
            </StackPanel>

            <!-- Error message -->
            <Border Classes="hint"
                    IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
              <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Ellipse Width="6" Height="6" Fill="{StaticResource Accent}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding ErrorMessage}"
                           FontSize="12"
                           Foreground="{StaticResource Accent}"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap" />
              </StackPanel>
            </Border>

            <Button Classes="loginBtn"
                    Content="{Binding LoginButtonText}"
                    Command="{Binding LoginCommand}"
                    HorizontalAlignment="Stretch"
                    Margin="0,4,0,0" />

          </StackPanel>
        </Grid>
      </Border>

    </StackPanel>

    <!-- ── Footer ───────────────────────────────────────────────── -->
    <TextBlock Grid.Row="2"
               Text="© 2026 Feral Tech Supplies · All rights reserved."
               FontSize="10"
               Foreground="{StaticResource TextDisabled}"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               LetterSpacing="0.5" />

  </Grid>
</Window>
