<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Style Selector="Window">
    <Setter Property="Background" Value="#0A0A0A" />
    <Setter Property="Foreground" Value="White" />
  </Style>

  <Style Selector="Button.pose">
    <Setter Property="Height" Value="62" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="16,10" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>

  <Style Selector="TextBlock.panelTitle">
    <Setter Property="FontSize" Value="22" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="LetterSpacing" Value="2" />
  </Style>

  <Style Selector="Border.card">
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="#33EF4444" />
    <Setter Property="Background" Value="#111111" />
    <Setter Property="Padding" Value="16" />
  </Style>

  <Style Selector="Border.statCard">
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Background" Value="#111111" />
    <Setter Property="BorderBrush" Value="#2AEF4444" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="12,14" />
  </Style>

  <Style Selector="Border.hint">
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Background" Value="#1A0000" />
    <Setter Property="BorderBrush" Value="#33EF4444" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="Margin" Value="0,0,0,6" />
  </Style>

</Styles>
