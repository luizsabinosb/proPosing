"""
FastAPI Application - ProPosing Backend
"""
import logging
import time
from contextlib import asynccontextmanager

from fastapi import FastAPI
from fastapi.middleware.cors import CORSMiddleware
from fastapi.middleware.gzip import GZipMiddleware

logger = logging.getLogger(__name__)

_startup_time: float = 0.0


@asynccontextmanager
async def lifespan(app: FastAPI):
    """Inicializa serviços no startup e libera recursos no shutdown."""
    global _startup_time

    logging.basicConfig(
        level=logging.INFO,
        format="%(asctime)s [%(levelname)s] %(name)s: %(message)s",
    )

    logger.info("ProPosing backend iniciando...")
    _startup_time = time.time()

    # Pré-aquece o CVService na inicialização (carrega MediaPipe antes
    # do primeiro request, eliminando latência no primeiro frame).
    from app.api.v1.pose import get_cv_service
    try:
        get_cv_service()
        logger.info("CVService pronto.")
    except Exception as exc:
        logger.error("Falha ao inicializar CVService: %s", exc)

    yield

    logger.info("ProPosing backend encerrando.")


app = FastAPI(
    title="ProPosing API",
    description="API para análise de poses de fisiculturismo",
    version="1.0.0",
    lifespan=lifespan,
)

# GZip: imagens anotadas em Base64 comprimem ~60-70% — redução real de latência.
app.add_middleware(GZipMiddleware, minimum_size=512)

# CORS
app.add_middleware(
    CORSMiddleware,
    allow_origins=["*"],          # Em produção: especificar origens
    allow_credentials=True,
    allow_methods=["GET", "POST"],
    allow_headers=["*"],
)

# Rotas
from app.api.v1 import pose          # noqa: E402 — após middleware setup
app.include_router(pose.router, prefix="/api/v1/pose", tags=["pose"])


@app.get("/")
async def root():
    return {"message": "ProPosing API", "version": "1.0.0", "docs": "/docs"}


@app.get("/health")
async def health():
    return {
        "status": "healthy",
        "uptime_seconds": round(time.time() - _startup_time, 1),
    }
